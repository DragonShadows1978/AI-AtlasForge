    {
      "id": 8,
      "title": "GPTQ: Accurate Post-Training Quantization for Generative Pre-trained Transformers",
      "authors": "Elias Frantar, Saleh Ashkboos, Torsten Hoefler, Dan Alistarh",
      "year": 2022,
      "venue": "NeurIPS 2022 / arXiv: 2210.17323",
      "url": "https://arxiv.org/pdf/2210.17323",
      "type": "Foundational method",
      "key_equations": [
        {
          "name": "Loss Approximation (Quadratic Proxy)",
          "formula": "ΔL ≈ ||W_q - W||_H^2 = Σ_i (w_{q,i} - w_i) × H_{ii} × (w_{q,i} - w_i)",
          "description": "Hessian-based second-order loss approximation"
        },
        {
          "name": "Hessian Computation",
          "formula": "H = (2/|D|) × Σ_{batch ∈ D} X^T × X",
          "description": "Hessian matrix from input activations"
        },
        {
          "name": "Layer-wise MSE Minimization",
          "formula": "Minimize: ||X·W_q - X·W||_2^2",
          "description": "Per-layer quantization objective"
        },
        {
          "name": "Greedy Weight Quantization",
          "formula": "w_{q,i} = clip(w_i - H_{ii}^(-1) × H_{i,¬i} × (W_{q,¬i} - W_{¬i}), Q_min, Q_max)",
          "description": "Optimal per-weight quantization accounting for dependencies"
        }
      ],
      "innovation": "Second-order Hessian-based approach; per-channel/per-group precision; highly accurate low-bit quantization",
      "capabilities": [
        "2, 3, 4-bit weight quantization",
        "Per-channel and per-group precision",
        "175B parameter models in ~4 GPU hours"
      ]
    },
