# ===================================
# AI-AtlasForge Git Ignore Configuration
# ===================================

# ------ Mission & Runtime Data ------
# Mission data (runtime generated)
missions/
checkpoints/

# State/runtime data (critical for operation, not versioned)
state/
atlasforge_data/
rde_data/
backups/
experiments/

# Runtime logs and screenshots
logs/
screenshots/

# Process ID files
*.pid

# ------ Python ------
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# ------ Large Files (ML/Models) ------
*.onnx
*.pth
*.pt
*.pkl
*.model
*.weights
*.h5
*.ckpt
*.safetensors
*.bin

# ------ Temp Files ------
*.log
*.tmp
*.temp
*.bak
*.swp
*~
*.pre_restore
*.orig
*.backup
*.pre_recovery_backup

# ------ Deployment Artifacts ------
deploy.log

# Workspace (transient work area)
workspace/

# ------ Developer Mode Marker ------
# Signals active development - bypasses version update checks
.dev_mode

# ------ Environment & Secrets ------
.env
.env.local
.env.*.local

# ------ Node.js ------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
yarn.lock

# ------ Build Artifacts ------
*.bundle.js
*.bundle.js.map

# ------ Investigations (personal data) ------
investigations/

# ------ Predictive Drift (personal infrastructure) ------
predictive_drift/

# ------ Personal/Internal Documentation ------
# Keep these out of public release
docs/internal/
*.personal.md

# ------ Claude local settings (may contain local paths/secrets) ------
# Hooks are tracked in claude_hooks/ instead
.claude/
!.claude/
.claude/*
!.claude/settings.json
!.claude/hooks/
.claude/hooks/*
!.claude/hooks/backup-core-files.py
!.claude/hooks/exploration-memory-hook.py

# ------ Jupyter Notebooks ------
.ipynb_checkpoints/
*.ipynb

# ------ Coverage Reports ------
htmlcov/
.coverage
.coverage.*
coverage.xml

# ------ SSL Certificates ------
certs/

# ------ Recovery Artifacts ------
recovery_*/
recovery_restore_backup_*/
recovery_ai_storyforge_*/

# ------ Mypy Cache ------
.mypy_cache/

# ------ Investigation Validator Cache ------
investigation_validator/.source_cache/

# Stale lock files
tmp*.lock
.af_archives/
.af_snapshots/

# Local config (not public-facing)
config.yaml
