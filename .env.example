# AI-AtlasForge Environment Variables
# Copy this file to .env and modify as needed
#
# Note: .env files are NOT tracked in git for security.
# These settings override config.yaml when set.

# ============================================
# REQUIRED
# ============================================

# Your Anthropic API key for Claude access
ANTHROPIC_API_KEY=your-api-key-here

# ============================================
# OPTIONAL - Override defaults
# ============================================

# Override base directory (default: script location)
# ATLASFORGE_ROOT=/path/to/ai-atlasforge

# Dashboard port (default: 5050)
ATLASFORGE_PORT=5050

# Enable debug mode (default: false)
ATLASFORGE_DEBUG=false

# Virtual display for headless operation (default: :99)
DISPLAY=:99

# ============================================
# WEB PROXY (Optional, recommended)
# ============================================
# The local web proxy routes subagent WebSearch/WebFetch tool calls
# through a cached, unfiltered HTTP service. See WebProxy/docs/LOCAL_WEB_PROXY.md.

# Brave Search API key. If set, the proxy uses Brave; otherwise falls
# back to DuckDuckGo HTML scraping. NEVER commit an actual key.
# BRAVE_API_KEY=

# Proxy endpoint (default: http://127.0.0.1:8765)
# WEB_PROXY_URL=http://127.0.0.1:8765
# ATLASFORGE_WEB_PROXY_URL=http://127.0.0.1:8765

# Override MCP config path (default: $ATLASFORGE_ROOT/WebProxy/configs/mcp.json)
# ATLASFORGE_MCP_CONFIG=

# Disable dashboard auto-start of the web proxy (useful if you prefer systemd)
# ATLASFORGE_DISABLE_PROXY_AUTOSTART=1

# ============================================
# OLLAMA (Optional local LLM)
# ============================================

# Ollama server URL
OLLAMA_URL=http://localhost:11434

# Default Ollama model
OLLAMA_MODEL=llama3.1:8b

# ============================================
# ADVANCED
# ============================================

# Python path additions (colon-separated)
# PYTHONPATH=/additional/path:${PYTHONPATH}

# Disable color output
# NO_COLOR=1

# Force unbuffered Python output
PYTHONUNBUFFERED=1
