  "awq_vs_alternatives": {
    "awq_core_principle": {
      "description": "Activation-aware Weight Quantization",
      "formula": "importance = std(activation_channel) × |weight_channel|",
      "key_innovation": "Ranks weight precision by actual activation statistics, not just magnitude"
    },
    "comparison_matrix": {
      "awq_vs_gptq": {
        "calibration_time": "1-5 min vs 1-2 hours (GPTQ layer-serial)",
        "perplexity_4bit": "0.05-0.3 PPL vs 0.2-0.8 PPL",
        "preferred_use_case": "Production inference (speed/simplicity)",
        "extreme_bits": "GPTQ better at 2-3 bit; AWQ struggles below 4-bit"
      },
      "awq_vs_rtn": {
        "quality_difference": "20-50× (0.3 PPL vs 5-8 PPL)",
        "reason": "Activation-aware importance vs naive magnitude",
        "runtime_cost": "Same (just weights quantized)"
      },
      "awq_vs_qlora": {
        "training_required": "AWQ: none; QLORA: 24h+",
        "quality": "QLORA slightly better but both excellent at 4-bit",
        "use_case": "AWQ = inference-only; QLORA = fine-tuning + inference"
      }
    }
  },

