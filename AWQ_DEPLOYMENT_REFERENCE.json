  "evaluation_metrics": {
    "perplexity_standard": {
      "datasets": ["WikiText2 (standard)", "C4 (diverse)", "PTB (classic)"],
      "formula": "PPL = exp(-1/N Σ log p(token_i))",
      "reporting": "Absolute delta (e.g., '+0.3 PPL'), not percentage",
      "baseline": "Always measure FP16 on same dataset first"
    },
    "complementary_metrics": {
      "zero_shot_tasks": ["MMLU (57 subjects)", "ARC", "HellaSwag", "Code: HumanEval"],
